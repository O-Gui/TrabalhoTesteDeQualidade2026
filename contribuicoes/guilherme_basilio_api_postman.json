    {
      "name": "API 02 - Alertas",
      "item": [
        {
          "name": "CT04 - Listar alertas com contrato valido",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code deve ser 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Total deve existir\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"total\");",
                  "});",
                  "pm.test(\"Dados deve ser uma lista\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.dados).to.be.an(\"array\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/alertas",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "alertas"
              ]
            }
          }
        }
      ]
    }
  ]
