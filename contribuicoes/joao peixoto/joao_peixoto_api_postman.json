    {
      "name": "API 02 - SOS",
      "item": [
        {
          "name": "CT04 - Acionar SOS com sucesso",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code deve ser 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Mensagem de SOS\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.mensagem).to.eql(\"SOS acionado e familia notificada\");",
                  "});",
                  "",
                  "pm.test(\"Tipo deve ser SOS\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.dados.tipo).to.eql(\"SOS\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paciente\": \"Maria de Lourdes\",\n  \"localizacao\": \"Residencia\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/sos",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "sos"
              ]
            }
          }
        }
      ]
    }
