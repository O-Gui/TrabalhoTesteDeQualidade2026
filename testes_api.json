      "name": "API 01 - Cadastro de Paciente (Idoso)",
      "item": [
        {
          "name": "CT01 - Idade inválida",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code deve ser 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"Mensagem de erro de idade\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.mensagem).to.eql(\"Idade inválida\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"João Batista\",\n  \"idade\": -5,\n  \"necessidadePrincipal\": \"Acompanhamento de medicação\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/pacientes",
              "protocol": "http",
              "host": [
